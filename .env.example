REDFORGE_ENVIRONMENT=development
REDFORGE_WORKSPACE_ROOT=
REDFORGE_LLM_BASE_URL=
REDFORGE_LLM_MODEL=
REDFORGE_LLM_API_KEY=

REDFORGE_REPAIR_ON_FAILURE=true
REDFORGE_MAX_REPAIR_ATTEMPTS=2

REDFORGE_PRODUCTION_RUNTIME_ENABLED=true
REDFORGE_ADVANCED_VERIFICATION_ENABLED=true
REDFORGE_MINIMUM_COVERAGE=70
REDFORGE_ALLOWED_EGRESS_HOSTS=github.com,api.github.com
REDFORGE_AUDIT_LOG_PATH=
REDFORGE_MAX_CONCURRENT_RUNS=4
REDFORGE_MULTI_AGENT_REQUIRED_APPROVALS=2

REDFORGE_E2E_INTEGRATION_ENABLED=true
REDFORGE_HUMAN_APPROVAL_RISK_THRESHOLD=20

REDFORGE_AUTONOMOUS_RUNTIME_ENABLED=true
REDFORGE_DEEP_REPOSITORY_INTELLIGENCE_ENABLED=true
REDFORGE_ENGINEERING_MEMORY_ENABLED=true
REDFORGE_DOCKER_ISOLATION_ENABLED=true
REDFORGE_GITHUB_LIVE_AUTOMATION_ENABLED=false
REDFORGE_EVALUATION_ENABLED=true

# GitHub issue automation (v1.6.0)
REDFORGE_GITHUB_TOKEN=
REDFORGE_GITHUB_WEBHOOK_SECRET=
REDFORGE_GITHUB_AUTOMATION_LABEL=redforge
REDFORGE_GITHUB_LIVE_AUTOMATION_ENABLED=false
REDFORGE_GITHUB_AUTO_PUBLISH_ENABLED=false
